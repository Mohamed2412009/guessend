<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    tools:context=".showsTops">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Top 3 Scores"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvTop1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="1. No Data" />

    <TextView
        android:id="@+id/tvTop2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="2. No Data" />

    <TextView
        android:id="@+id/tvTop3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:padding="12dp"
        android:background="#E0E0E0"
        android:layout_marginBottom="32dp"
        android:gravity="center"
        android:text="3. No Data" />

    <Button
        android:id="@+id/btnNewGameTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="New Game"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnExitTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exit" />

</LinearLayout>